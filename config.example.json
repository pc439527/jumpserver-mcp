{
  "_comment": "V0.5.0: host / port / username / password 现在可以完全交给 WorkBuddy 连接器表单填写（注入为环境变量 JUMPSERVER_HOST / PORT / USERNAME / PASSWORD），优先级高于本文件。本文件保留权限模式、目标范围、并发、资产组、Runbook 等高级策略；当环境变量已提供连接信息时，本文件可以不存在。",
  "host": "203.0.113.10",
  "port": 2222,
  "username": "your-jumpserver-user",
  "passwordEnv": "JUMPSERVER_PASSWORD",
  "hostFingerprint": "",
  "knownHostsPath": "",
  "permissionMode": "READ_ONLY",
  "timeZone": "Asia/Shanghai",
  "allowedTargets": [],
  "deniedTargets": [],
  "batchConcurrency": 1,
  "maxSessions": 4,
  "assetGroups": {
    "OA": { "keywords": ["OA", "portal", "workflow", "办公"] }
  },
  "runbooks": {
    "oa-health": {
      "title": "OA 集群健康巡检",
      "description": "主机基础 + 网络监听 + 进程，逐台执行同样的只读检查；带断言，自动给出 PASS/FAIL 结论。",
      "steps": [
        { "id": "host", "title": "主机基础", "profile": "basic", "expect": { "notEmpty": true, "minLines": 3 } },
        { "id": "net", "title": "监听端口", "profile": "network", "expect": { "probe": "listen", "contains": "LISTEN" } },
        {
          "id": "nginx",
          "title": "nginx 是否在跑",
          "command": "ps -ef | grep -c [n]ginx",
          "expect": { "notContains": " 0", "exitCode": 0, "message": "nginx 未运行" }
        },
        { "id": "proc", "title": "进程 TOP", "profile": "process" }
      ]
    }
  },
  "auditViewer": {
    "_comment": "stableUrl=true 时控制台固定在 http://127.0.0.1:8765/（地址不含令牌，令牌由服务端注入页面），进程重启后同一地址仍可访问；此时 portFallback 被忽略，端口被占用时本进程改为\"接管\"而不是降级到随机端口。",
    "enabled": true,
    "port": 8765,
    "autoOpen": true,
    "stableUrl": true,
    "portFallback": false,
    "tokenTtlMinutes": 720
  }
}
